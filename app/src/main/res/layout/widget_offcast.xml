<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0A1220">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Offcast"
        android:textColor="#E8F0FF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Abrir Offcast"
        android:textColor="#04101F"
        android:backgroundTint="#6FA8FF" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Biblioteca"
        android:textColor="#9CC2FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_episodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_ep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E8F0FF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_ep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E8F0FF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_ep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E8F0FF"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
